# Configuration de l'API. Copier en `backend/.env`. Ne jamais committer `.env`.
# Les identifiants ci-dessous sont ceux des services locaux de infra/compose.yaml.

ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://soontrade:soontrade@127.0.0.1:5432/soontrade
CORS_ORIGINS=["http://localhost:3000"]

# --- Authentification et e-mails ---
# Adresse du site, utilisée dans les liens envoyés par e-mail.
FRONTEND_URL=http://localhost:3000
# Laisser vide en local : les e-mails sont alors écrits dans les logs de l'API.
RESEND_API_KEY=
EMAIL_FROM=SOON TRADE <no-reply@soontrade.com>

# --- Données de démonstration (local uniquement) ---
# Mot de passe commun des comptes créés par `python -m app.seed`. À choisir vous-même.
SEED_PASSWORD=

# --- Services locaux ---
REDIS_URL=redis://127.0.0.1:6380/0
# Émulateur S3 local. En production : laisser S3_ENDPOINT_URL vide et renseigner les clés AWS.
S3_ENDPOINT_URL=http://127.0.0.1:9090
S3_BUCKET=soon-trade-documents
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
